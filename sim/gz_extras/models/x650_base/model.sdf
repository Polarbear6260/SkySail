<?xml version="1.0" encoding="UTF-8"?>
<!--
  X650 基础模型（不含电机模型插件，插件在 model://x650 中）

  参数来源：BOM「重量与续航评估」
    起飞总重 m_total = 3.5767 kg   （含 1 块 6S 6800mAh 930 g）
    轴距（对角电机中心距） = 0.650 m  → 电机到中心 0.325 m → x=y=0.2298 m
    机架：Holybro X650 V2 ARF（碳板 + 折叠机臂 + 起落架）

  质量分配（4 个 rotor link 各 0.09 kg：桨 15×5 + 电机转子/桨夹）
    base_link = 3.5767 - 4×0.09 = 3.2167 kg
  惯量按 0.65×0.65×0.20 m 均质箱体估算：
    Ixx = Iyy = m/12·(0.65² + 0.20²) = 0.1240
    Izz       = m/12·(0.65² + 0.65²) = 0.2265

  与上游 x500_base 的差异：质量 2.0→3.2167 kg、轴距 0.246→0.650 m、桨 11"→15"。
  传感器噪声沿用上游 x500_base（IMU 按 IIM42653、磁罗盘按 IIS2MDC、气压计按 BMP390）。
-->
<sdf version="1.9">
  <model name="x650_base">
    <pose>0 0 0.28 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>3.2167</mass>
        <inertia>
          <ixx>0.1240</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1240</iyy>
          <iyz>0</iyz>
          <izz>0.2265</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />

      <!-- 机身：X650 中心板（视觉用简化几何，物理用碰撞盒） -->
      <visual name="body_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.36 0.36 0.06</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- 机臂 ×4（45° 折叠臂，指向四个电机） -->
      <visual name="arm_visual_0">
        <pose>0.1149 -0.1149 0.03 0 0 -0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.325</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.62 0.62 0.62 1</diffuse>
        </material>
      </visual>
      <visual name="arm_visual_1">
        <pose>-0.1149 0.1149 0.03 0 0 -0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.325</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.62 0.62 0.62 1</diffuse>
        </material>
      </visual>
      <visual name="arm_visual_2">
        <pose>0.1149 0.1149 0.03 0 0 0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.325</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.62 0.62 0.62 1</diffuse>
        </material>
      </visual>
      <visual name="arm_visual_3">
        <pose>-0.1149 -0.1149 0.03 0 0 0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.325</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.62 0.62 0.62 1</diffuse>
        </material>
      </visual>

      <!-- 碰撞：中心板 -->
      <collision name="body_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.36 0.36 0.06</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>

      <!-- 碰撞：四根起落架（脚架外伸，落地时不至于让桨先着地） -->
      <collision name="leg_collision_0">
        <pose>0.16 0.16 -0.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.02 0.26</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <collision name="leg_collision_1">
        <pose>-0.16 0.16 -0.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.02 0.26</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <collision name="leg_collision_2">
        <pose>0.16 -0.16 -0.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.02 0.26</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <collision name="leg_collision_3">
        <pose>-0.16 -0.16 -0.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.02 0.26</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>

      <!-- 传感器：与上游 x500_base 一致，噪声按真实器件建模 -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- 电机：rotor_0 前右(CCW) rotor_1 后左(CCW) rotor_2 后右(CW) rotor_3 前左(CW)
         与 PX4 Quad-X 编号 1..4 对应，顺序由 airframe 的 SIM_GZ_EC_FUNC 决定 -->
    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.2298 -0.2298 0.06 0 0 0</pose>
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <iyy>0.0006</iyy>
          <izz>0.0012</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_0_motor_visual">
        <pose>0 0 -0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.021</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_0_collision">
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.2298 0.2298 0.06 0 0 0</pose>
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <iyy>0.0006</iyy>
          <izz>0.0012</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_1_motor_visual">
        <pose>0 0 -0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.021</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.2298 0.2298 0.06 0 0 0</pose>
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <iyy>0.0006</iyy>
          <izz>0.0012</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_2_motor_visual">
        <pose>0 0 -0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.021</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_2_collision">
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.2298 -0.2298 0.06 0 0 0</pose>
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <iyy>0.0006</iyy>
          <izz>0.0012</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_3_motor_visual">
        <pose>0 0 -0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.021</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_3_collision">
        <geometry>
          <box>
            <size>0.381 0.024 0.002</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
  </model>
</sdf>
