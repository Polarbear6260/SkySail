          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="aruco3_plate">
          <pose>0.4500 0.1500 0.4820 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.2200 0.2200</size></plane></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="aruco3_w00">
