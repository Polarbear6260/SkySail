<?xml version="1.0" encoding="UTF-8"?>
<!--
  X650 海上移动平台世界（运动学船，不含浮力）

  设计取舍：
    · 船是 static 模型，由 scripts/10_move_platform.py 用 /world/<world>/set_pose
      服务按预设轨迹移动（圆/track + 升沉 + 横摇 + 纵摇）——确定性、可重复、易验证；
    · 水面只做视觉（无碰撞），避免落水判定干扰；真正的浮力/波浪耦合留给后续
      （gz-sim 有 buoyancy / hydrodynamics 插件，但调参成本高）；
    · 落点板在船体坐标系 (0.3, 0, 0.55)，控制器需要它的世界位姿。

  用法：
    gz sim -r -s gz_extras/worlds/x650_sea.sdf      # 起世界
    python3 scripts/10_move_platform.py             # 驱动船运动
-->
<sdf version="1.9">
  <world name="x650_sea">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.45 0.55 0.65 1</ambient>
      <background>0.55 0.7 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 海面：只有视觉，防止落水判定干扰 -->
    <model name="sea_surface">
      <static>true</static>
      <link name="link">
        <visual name="water">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.02 0.15 0.3 1</ambient>
            <diffuse>0.05 0.25 0.45 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 移动平台：船 + 落点板（static，由驱动脚本移动） -->
    <model name="ship">
      <static>true</static>
      <pose>0 0 0.36 0 0 0</pose>
      <link name="hull">
        <inertial>
          <mass>300</mass>
          <inertia>
            <ixx>90</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>420</iyy><iyz>0</iyz>
            <izz>480</izz>
          </inertia>
        </inertial>

        <!-- 船体 -->
        <visual name="hull_visual">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.55</size></box></geometry>
          <material><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
        <collision name="hull_collision">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.55</size></box></geometry>
        </collision>

        <!-- 甲板 -->
        <visual name="deck_visual">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.04</size></box></geometry>
          <material><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
        <collision name="deck_collision">
          <pose>0 0 0.30 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.30</size></box></geometry>
        </collision>

        <!-- 驾驶舱 -->
        <visual name="cabin_visual">
          <pose>-1.25 0 0.74 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.6</size></box></geometry>
          <material><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
        <collision name="cabin_collision">
          <pose>-1.25 0 0.74 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.6</size></box></geometry>
        </collision>

        <!-- 着陆板：中心 (0.3, 0, 0.45)，板面 z=0.45 -->
        <visual name="pad_visual">
          <pose>0.3 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.05 0.05 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="pad_ring_visual">
          <pose>0.3 0 0.455 0 0 0</pose>
          <geometry><cylinder><radius>0.58</radius><length>0.006</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <collision name="pad_collision">
          <pose>0.3 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>0.04</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <!-- 挡边：防止上锁后在移动甲板上滑出去 -->
        <visual name="pad_rim_visual">
          <pose>0.3 0 0.47 0 0 0</pose>
          <geometry><cylinder><radius>0.60</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.9 0.85 0.3 1</ambient><diffuse>0.95 0.9 0.35 1</diffuse></material>
        </visual>
        <collision name="pad_rim">
          <pose>0.3 0 0.47 0 0 0</pose>
          <geometry><cylinder><radius>0.60</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
