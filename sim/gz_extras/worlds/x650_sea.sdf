<?xml version="1.0" encoding="UTF-8"?>
<!--
  X650 海上移动平台世界（运动学船，不含浮力）

  设计取舍：
    · 船是 static 模型，由 scripts/10_move_platform.py 用 /world/<world>/set_pose
      服务按预设轨迹移动（圆/track + 升沉 + 横摇 + 纵摇）——确定性、可重复、易验证；
    · 水面只做视觉（无碰撞），避免落水判定干扰；真正的浮力/波浪耦合留给后续
      （gz-sim 有 buoyancy / hydrodynamics 插件，但调参成本高）；
    · 落点板在船体坐标系 (0.3, 0, 0.55)，控制器需要它的世界位姿。

  用法：
    gz sim -r -s gz_extras/worlds/x650_sea.sdf      # 起世界
    python3 scripts/10_move_platform.py             # 驱动船运动
-->
<sdf version="1.9">
  <world name="x650_sea">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.45 0.55 0.65 1</ambient>
      <background>0.55 0.7 0.85 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 海面：只有视觉，防止落水判定干扰 -->
    <model name="sea_surface">
      <static>true</static>
      <link name="link">
        <visual name="water">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.02 0.15 0.3 1</ambient>
            <diffuse>0.05 0.25 0.45 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- 固定起飞台：离船约 16 m，台面高 1.0 m，飞机从这里起飞 -->
    <model name="dock">
      <static>true</static>
      <pose>0 16 0 0 0 0</pose>
      <link name="link">
        <visual name="deck">
          <pose>0 0 0.98 0 0 0</pose>
          <geometry><box><size>2.4 2.4 0.08</size></box></geometry>
          <material><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
        <collision name="deck_col">
          <pose>0 0 0.98 0 0 0</pose>
          <geometry><box><size>2.4 2.4 0.08</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="leg1"><pose>0.9 0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry><material><diffuse>0.3 0.3 0.34 1</diffuse></material></visual>
        <visual name="leg2"><pose>-0.9 0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry><material><diffuse>0.3 0.3 0.34 1</diffuse></material></visual>
        <visual name="leg3"><pose>0.9 -0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry><material><diffuse>0.3 0.3 0.34 1</diffuse></material></visual>
        <visual name="leg4"><pose>-0.9 -0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry><material><diffuse>0.3 0.3 0.34 1</diffuse></material></visual>
        <collision name="legc1"><pose>0.9 0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry></collision>
        <collision name="legc2"><pose>-0.9 0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry></collision>
        <collision name="legc3"><pose>0.9 -0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry></collision>
        <collision name="legc4"><pose>-0.9 -0.9 0.49 0 0 0</pose><geometry><box><size>0.18 0.18 0.98</size></box></geometry></collision>
        <!-- 停机标记 -->
        <visual name="mark"><pose>0 0 1.025 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>0.01</length></cylinder></geometry><material><diffuse>0.2 0.8 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 移动平台：船 + 落点板（static，由驱动脚本移动） -->
    <model name="ship">
      <!-- 动态刚体 + 关重力：这样接触是真实接触（静态体被 set_pose 瞬移时撑不住机体） -->
      <static>true</static>
      <pose>0 0 0.36 0 0 0</pose>
      <link name="hull">
        <inertial>
          <mass>300</mass>
          <inertia><ixx>90</ixx><ixy>0</ixy><ixz>0</ixz><iyy>420</iyy><iyz>0</iyz><izz>480</izz></inertia>
        </inertial>

        <!-- 船体 -->
        <visual name="hull_visual">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.55</size></box></geometry>
          <material><diffuse>0.78 0.78 0.80 1</diffuse></material>
        </visual>
        <collision name="hull_collision">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.55</size></box></geometry>
        </collision>

        <!-- 船首（45° 方块，做出尖头） -->
        <visual name="bow_visual">
          <pose>1.98 0 0.12 0 0 0.7854</pose>
          <geometry><box><size>1.13 1.13 0.55</size></box></geometry>
          <material><diffuse>0.78 0.78 0.80 1</diffuse></material>
        </visual>
        <collision name="bow_collision">
          <pose>1.98 0 0.12 0 0 0.7854</pose>
          <geometry><box><size>1.13 1.13 0.55</size></box></geometry>
        </collision>

        <!-- 甲板 -->
        <visual name="deck_visual">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.04</size></box></geometry>
          <material><diffuse>0.62 0.55 0.45 1</diffuse></material>
        </visual>
        <collision name="deck_collision">
          <pose>0 0 0.30 0 0 0</pose>
          <geometry><box><size>4.0 1.6 0.30</size></box></geometry>
        </collision>

        <!-- 甲板护栏 -->
        <visual name="rail_p"><pose>0 0.79 0.47 0 0 0</pose><geometry><box><size>4.0 0.03 0.06</size></box></geometry><material><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
        <visual name="rail_s"><pose>0 -0.79 0.47 0 0 0</pose><geometry><box><size>4.0 0.03 0.06</size></box></geometry><material><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>

        <!-- 驾驶舱 -->
        <visual name="cabin_visual">
          <pose>-1.25 0 0.74 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.6</size></box></geometry>
          <material><diffuse>0.88 0.88 0.85 1</diffuse></material>
        </visual>
        <collision name="cabin_collision">
          <pose>-1.25 0 0.74 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.6</size></box></geometry>
        </collision>
        <visual name="winch"><pose>-1.25 0 1.05 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>

        <!-- 着陆板：红色圆盘 + 白色外圈，抬高 2 cm 明显可见 -->
        <!-- ARUCO_BEGIN（由 scripts/20_make_aruco_sdf.py 生成） -->
        <visual name="aruco0_plate">
          <pose>0.1500 -0.1500 0.4820 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.2200 0.2200</size></plane></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="aruco0_w00">
          <pose>0.0950 -0.0950 0.4826 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.0367 0.0367</size></plane></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="aruco0_w02">
          <pose>0.1683 -0.0950 0.4826 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.0367 0.0367</size></plane></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
