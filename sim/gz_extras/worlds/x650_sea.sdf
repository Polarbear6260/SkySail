        </visual>
        <visual name="aruco1_w23">
          <pose>0.5050 -0.1683 0.4826 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.0367 0.0367</size></plane></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="aruco1_w30">
          <pose>0.3950 -0.2050 0.4826 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.0367 0.0367</size></plane></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
